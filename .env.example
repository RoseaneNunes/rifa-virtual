# URL do Web App do Google Apps Script que salva os comprovantes no Drive.
# Veja apps-script/receipt-webapp.gs para o código e o passo a passo.
RECEIPT_UPLOAD_URL=

# Mesmo valor de SHARED_SECRET definido no Apps Script.
RECEIPT_SHARED_SECRET=

# Planilha (CSV publicado) usada para saber quais números já foram reservados.
SHEET_CSV_URL=

# Nome da coluna da planilha que contém o número da rifa.
SHEET_NUMERO_COLUMN=numero da rifa
